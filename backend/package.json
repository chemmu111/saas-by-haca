{
  "name": "social-media-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node src/index.js",
    "migrate:users": "node --env-file=.env src/scripts/migrateUsersAddRole.js",
    "create:admin": "node --env-file=.env src/scripts/createAdminUser.js",
    "update:token": "node --env-file=.env src/scripts/updateAccessTokenAndUrls.js",
    "update:instagram-token": "node --env-file=.env src/scripts/updateInstagramToken.js",
    "check:missing-media": "node --env-file=.env src/scripts/cleanupMissingMedia.js",
    "postinstall": "node ./node_modules/puppeteer/lib/cjs/puppeteer/node/cli.js browsers install chrome"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.6.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.31.0",
    "resend": "^6.5.2",
    "sharp": "^0.33.0",
    "ua-parser-js": "^2.0.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.4.1",
    "supertest": "^7.1.4"
  }
}